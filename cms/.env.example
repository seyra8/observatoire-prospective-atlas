# ──────────────────────────────────────────────────────────────
# Environnement Directus / Postgres / Meilisearch
#   Copier ce fichier en ".env" et remplacer chaque valeur
#   ⚠️  Ne jamais committer le vrai .env
# ──────────────────────────────────────────────────────────────

# ── Directus ────────────────────────────────────────────────
# Générer avec : openssl rand -hex 32
DIRECTUS_KEY=change-me-key-32-chars-hex
DIRECTUS_SECRET=change-me-secret-32-chars-hex

# Admin bootstrap (utilisé une seule fois à la première exécution)
ADMIN_EMAIL=admin@observatoire-atlas.fr
ADMIN_PASSWORD=change-me-strong-password

# URL publique du Directus
PUBLIC_URL=http://localhost:8055

# CORS : origine du front Next.js
CORS_ORIGIN=http://localhost:3000

# ── Postgres ────────────────────────────────────────────────
DB_NAME=observatoire
DB_USER=observatoire
DB_PASSWORD=change-me-strong-db-password

# ── Meilisearch ─────────────────────────────────────────────
MEILI_MASTER_KEY=change-me-meili-master-key-32-chars
MEILI_ENV=development
