# ─── Directus ───────────────────────────────────────────────
# URL publique du CMS Directus (stack Docker locale par défaut)
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055

# Token d'accès statique côté serveur (jamais côté client !)
# À créer dans Directus > Users > user system > Access Tokens
DIRECTUS_STATIC_TOKEN=

# ─── Meilisearch (v0.4) ─────────────────────────────────────
NEXT_PUBLIC_MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=

# ─── Sentry (error tracking) — à réactiver en v0.4 ──────────
# Le code Sentry a été retiré en attendant une v0.4 plus stable.
# Pour le réactiver : re-ajouter @sentry/nextjs en deps + variables env :
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=observatoire-prospective-atlas
# SENTRY_AUTH_TOKEN=
