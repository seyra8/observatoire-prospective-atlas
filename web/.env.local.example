# ─── Directus ───────────────────────────────────────────────
# URL publique du CMS Directus (stack Docker locale par défaut)
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055

# Token d'accès statique côté serveur (jamais côté client !)
# À créer dans Directus > Users > user system > Access Tokens
DIRECTUS_STATIC_TOKEN=

# ─── Meilisearch (v0.4) ─────────────────────────────────────
NEXT_PUBLIC_MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=

# ─── Sentry (error tracking) ────────────────────────────────
# DSN public (visible côté client). Copier depuis Sentry > Project Settings > Client Keys.
NEXT_PUBLIC_SENTRY_DSN=

# Pour l'upload automatique de source maps au build (optionnel)
# Créer un token d'auth sur Sentry > Settings > Auth Tokens (scope : project:releases)
SENTRY_ORG=
SENTRY_PROJECT=observatoire-prospective-atlas
SENTRY_AUTH_TOKEN=
